{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://civitai.com/*",
    "https://*.civitai.com/*",
    "https://civitai.red/*",
    "https://*.civitai.red/*",
    "https://civitai.green/*",
    "https://*.civitai.green/*",
    "https://*.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "save-current-model": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveModel__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/*",
        "https://*.civitai.com/*",
        "https://civitai.red/*",
        "https://*.civitai.red/*",
        "https://civitai.green/*",
        "https://*.civitai.green/*"
      ],
      "js": [
        "src/content/scraper.js",
        "src/content/widget.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
